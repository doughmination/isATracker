# .env.example
# MIT — (c) Doughmination System®
# Copy to .env and fill in. In production it lives next to the build (see deploy/run).

# Alt account: classic token with no scopes for reading public repositories.
READ_GITHUB_TOKEN=

# Your maintainer account: classic token with only public_repo for moderation actions.
# Create tokens at https://github.com/settings/tokens (Tokens (classic)).
MAINTAINER_GITHUB_TOKEN=

# Existing GITHUB_TOKEN settings still work as the fallback maintainer token.
# If READ_GITHUB_TOKEN is empty, reads use the maintainer token too.

# Repositories to track, comma separated owner/name
GITHUB_REPOS=is-a-dev/register,free-domains/is-a.bot

# Discord bot token, and your own Discord user id (the only id allowed to press buttons)
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=

# Optional: post in this channel instead of a direct message
DISCORD_CHANNEL_ID=

# Set to true to rehearse: buttons report what they would do and nothing is sent to GitHub.
DRY_RUN=false

# Required outside the dev server
DASHBOARD_PASSWORD=

# The public address of the dashboard, needed for form posts in production
ORIGIN=http://localhost:3101

# Optional tuning: 30 is the minimum interval; rate limits still pause scanning.
POLL_INTERVAL_SECONDS=120
SCANNER_ENABLED=true
DATABASE_PATH=data/tracker.sqlite
MESSAGES_PATH=config/messages.jp
UNSUPPORTED_CNAMES_PATH=config/unsupportedCnames.jp
NS_MIN_MERGED_PRS=1
MAX_FILES_PER_PR=25
