# .env.example
# MIT — (c) Doughmination System®
# Copy to .env and fill in. In production it lives next to the build (see deploy/run).

# GitHub token for your own account, with pull request read and write on the repository
GITHUB_TOKEN=

GITHUB_REPO_OWNER=is-a-dev
GITHUB_REPO_NAME=register

# Discord bot token, and your own Discord user id (the only id allowed to press buttons)
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=

# Optional: post in this channel instead of a direct message
DISCORD_CHANNEL_ID=

# Dry run is ON unless this is set to false. While ON, nothing is sent to GitHub.
DRY_RUN=true

# Required outside the dev server
DASHBOARD_PASSWORD=

# The public address of the dashboard, needed for form posts in production
ORIGIN=http://localhost:3101

# Optional tuning
POLL_INTERVAL_SECONDS=120
SCANNER_ENABLED=true
DATABASE_PATH=data/tracker.sqlite
MESSAGES_PATH=config/messages.json
NS_MIN_MERGED_PRS=1
MAX_FILES_PER_PR=25
